# ============================================================
# Database - Game Service
# ============================================================
GAME_DB_NAME=game_db
GAME_DB_USERNAME=postgres
GAME_DB_PASSWORD=

# ============================================================
# Database - Library Service
# ============================================================
LIBRARY_DB_NAME=library_db
LIBRARY_DB_USERNAME=postgres
LIBRARY_DB_PASSWORD=

# ============================================================
# Database - Recommendation Service (precomputed-recs cache)
# Port 5434 in dev
# ============================================================
REC_DB_NAME=recommendation_db
REC_DB_USERNAME=postgres
REC_DB_PASSWORD=

# ============================================================
# Keycloak - Admin & Database
# ============================================================
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=

# ============================================================
# Keycloak - Realm & Client (used by Spring Boot services)
# ============================================================
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=game-cellar
KEYCLOAK_CLIENT_ID=game-cellar-client

# ============================================================
# API Gateway - Service Account (for user registration)
# Create client 'gateway-admin' in game-cellar realm with
# Service Accounts enabled + realm-management/manage-users role
# ============================================================
GATEWAY_ADMIN_CLIENT_ID=gateway-admin
GATEWAY_ADMIN_CLIENT_SECRET=

# ============================================================
# Service Ports
# ============================================================
GATEWAY_PORT=8000
GAME_SERVICE_PORT=8081
LIBRARY_SERVICE_PORT=8082
RECOMMENDATION_SERVICE_PORT=8083

# ============================================================
# API Gateway - Runtime
# ============================================================
# Marks auth cookies Secure. Must be true behind HTTPS in production,
# false for local http development or the browser drops the cookie.
COOKIE_SECURE=false

# Comma-separated origins allowed by CORS. Set to the public site origin
# in production; the dev value below matches the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173

# Keycloak origin the browser is redirected to during login. Differs from
# KEYCLOAK_AUTH_SERVER_URL when the gateway runs in Docker and Keycloak is
# reachable on a compose hostname the browser cannot resolve.
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# Where Keycloak sends the browser back after login. Must match a Valid Redirect
# URI on the game-cellar-client realm client exactly.
AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Origin the gateway redirects to once the login is complete.
APP_BASE_URL=http://localhost:5173

# ============================================================
# JPA schema handling
# ============================================================
# Flyway owns the schema, so services only validate against it.
# Never set this to update or create-drop against a real database.
DDL_AUTO=validate

# ============================================================
# Redis - shared cache + rate-limit buckets + pub/sub
# ============================================================
REDIS_PASSWORD=

# Feature flag: api-gateway rate-limit uses Redis-backed Bucket4j when true,
# falls back to in-memory Caffeine + Bucket4j when false (operational safety).
RECOMMENDATION_RATELIMIT_DISTRIBUTED=true

# Comma-separated IPs/CIDRs of proxies allowed to set X-Forwarded-For for rate-limit keys.
# Empty (default) means the header is ignored and the socket address is used, so a direct
# attacker cannot spoof X-Forwarded-For to dodge the per-IP login limit. Set to the edge
# proxy ranges (e.g. Cloudflare) once deployed behind one.
RATE_LIMIT_TRUSTED_PROXIES=

# ============================================================
# Service-to-service authentication
# ============================================================
# Shared secret for /internal/** endpoints (recommendation-service worker reads
# library-service without a user JWT). Generate with `openssl rand -hex 32`.
# Library-service rejects /internal/** when this is unset or mismatched.
INTERNAL_SERVICE_TOKEN=

# ============================================================
# IGDB / Twitch (register app at dev.twitch.tv/console)
# ============================================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional IGDB tuning (defaults shown). docker-compose.yml forwards every key
# below, so uncommenting one here is enough; no rebuild.
# IGDB_API_BASE_URL=https://api.igdb.com/v4   # only changed to point at a mock
# IGDB_CONNECT_TIMEOUT=2000                   # ms, request path (search, detail, browse fallback)
# IGDB_READ_TIMEOUT=10000                     # ms, request path
# IGDB_WORKER_ENABLED=true
# IGDB_WORKER_DISCOVERY_LIMIT=500             # games per page (IGDB max)
# IGDB_WORKER_DISCOVERY_PAGES=50              # pages per nightly run (50 x 500 = 25k)
# IGDB_WORKER_NEW_RELEASES_PAGES=10           # recent-releases pages per run
# IGDB_WORKER_CRON=0 30 3 * * *               # container time is UTC
# IGDB_WORKER_RATE_LIMIT_DELAY_MS=250         # pause between IGDB calls inside the worker
# IGDB_WORKER_READ_TIMEOUT=30000              # ms, the worker's bulk pages (request path keeps IGDB_READ_TIMEOUT)
# IGDB_WORKER_RETRY_DELAY_MS=2000             # wait before the single retry of a failed page

# ============================================================
# Frontend (Vite, baked at build time)
# ============================================================
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=game-cellar
VITE_KEYCLOAK_CLIENT_ID=game-cellar-client

# Login transition timing
# VITE_LOGIN_TRANSITION_MIN_MS=700         # first-ever login on this device
# VITE_LOGIN_TRANSITION_MIN_MS_REPEAT=200  # subsequent logins
# VITE_LOGIN_TRANSITION_MAX_MS=1500        # hard cap before forcing nav
