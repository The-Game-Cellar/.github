# ============================================================
# Database - Game Service
# ============================================================
GAME_DB_NAME=game_db
GAME_DB_USERNAME=postgres
GAME_DB_PASSWORD=

# ============================================================
# Database - Library Service
# ============================================================
LIBRARY_DB_NAME=library_db
LIBRARY_DB_USERNAME=postgres
LIBRARY_DB_PASSWORD=

# ============================================================
# Keycloak - Admin & Database
# ============================================================
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_NAME=keycloak_db
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD=

# ============================================================
# Keycloak - Realm & Client (used by Spring Boot services)
# ============================================================
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=game-cellar
KEYCLOAK_CLIENT_ID=game-cellar-client
KEYCLOAK_CLIENT_SECRET=

# ============================================================
# API Gateway - Service Account (for user registration)
# Create client 'gateway-admin' in game-cellar realm with
# Service Accounts enabled + realm-management/manage-users role
# ============================================================
GATEWAY_ADMIN_CLIENT_ID=gateway-admin
GATEWAY_ADMIN_CLIENT_SECRET=

# ============================================================
# Service Ports
# ============================================================
GATEWAY_PORT=8000
GAME_SERVICE_PORT=8081
LIBRARY_SERVICE_PORT=8082
RECOMMENDATION_SERVICE_PORT=8083

# ============================================================
# IGDB / Twitch (register app at dev.twitch.tv/console)
# ============================================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional IGDB worker tuning (defaults shown)
# IGDB_WORKER_ENABLED=true
# IGDB_WORKER_DISCOVERY_PAGES=200       # pages per nightly run (500 games/page)
# IGDB_WORKER_DISCOVERY_LIMIT=500       # max games per page (IGDB max)
# IGDB_WORKER_NEW_RELEASES_PAGES=10     # recent releases pages per run
# IGDB_WORKER_ENRICHMENT_LIMIT=400      # stubs to enrich per run
# IGDB_WORKER_CRON=0 30 3 * * *

# ============================================================
# Frontend (Vite, baked at build time)
# ============================================================
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=game-cellar
VITE_KEYCLOAK_CLIENT_ID=game-cellar-client

# Login transition timing
# VITE_LOGIN_TRANSITION_MIN_MS=700         # first-ever login on this device
# VITE_LOGIN_TRANSITION_MIN_MS_REPEAT=200  # subsequent logins
# VITE_LOGIN_TRANSITION_MAX_MS=1500        # hard cap before forcing nav
